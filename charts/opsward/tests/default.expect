# The configuration, mounted as a directory so edits reload.
kind: ConfigMap
opsward.yaml: |
mountPath: /etc/opsward/config
# The reader profile: a ServiceAccount, its token, and a kubeconfig using it in-cluster.
name: opsward-reader
type: kubernetes.io/service-account-token
kubernetes.io/service-account.name: opsward-reader
tokenFile: /etc/opsward/tokens/reader/token
server: https://kubernetes.default.svc
mountPath: /etc/opsward/kubeconfig/reader
# The pod's own identity carries no token.
automountServiceAccountToken: false # the pod's own identity carries no token
# Hardening.
runAsNonRoot: true
readOnlyRootFilesystem: true
- ALL
type: RuntimeDefault
# SQLite and Go write temporary files.
mountPath: /tmp
# A change to a section that needs a restart rolls the pod.
checksum/restart:
# SQLite on a volume, one replica, replaced rather than rolled.
kind: PersistentVolumeClaim
mountPath: /var/lib/opsward
replicas: 1
type: Recreate
terminationGracePeriodSeconds: 150
# Health.
path: /healthz
path: /readyz
- serve
- /etc/opsward/config/opsward.yaml
! kind: Ingress
! kind: ClusterRole
